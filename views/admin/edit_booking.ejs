<!DOCTYPE html>
<html>
<head>
  <title>Edit Booking</title>
  <style>
    body { background:#f4f6f8; font-family:Arial; }
    .box {
      max-width:600px;
      margin:40px auto;
      background:#fff;
      padding:20px;
      border-radius:6px;
    }
    label { font-weight:600; display:block; margin-top:10px; }
    input, textarea, select {
      width:100%; padding:10px; margin-top:5px;
      border:1px solid #ccc; border-radius:5px;
    }
    button {
      margin-top:15px;
      background:#3498db;
      color:#fff;
      border:none;
      padding:10px 18px;
      border-radius:5px;
      cursor:pointer;
    }
  </style>
</head>
<body>

<div class="box">
  <h2>Edit Booking</h2>

  <form method="POST" action="/admin/update_booking/<%= booking.id %>">

    <label>Name</label>
    <input type="text" name="name" value="<%= booking.name %>" required>

    <label>Email</label>
    <input type="email" name="email" value="<%= booking.email %>" required>

    <label>Phone</label>
    <input type="text" name="phone" value="<%= booking.phone %>" required>

    <label>Event Type</label>
    <input type="text" name="event_type" value="<%= booking.event_type %>" required>

    <label>Event Date</label>
    <input type="date" name="event_date"
      value="<%= booking.event_date.toISOString().slice(0,10) %>" required>

    <label>Message</label>
    <textarea name="message"><%= booking.message %></textarea>

    <button type="submit">Update Booking</button>
    <a href="/admin/Bookings">Back</a>
  </form>
</div>

</body>
</html>
