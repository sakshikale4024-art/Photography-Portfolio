<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Photography Portfolio | Capturing Moments That Last Forever</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/slick-carousel/1.8.1/slick.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/slick-carousel/1.8.1/slick-theme.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        
        body {
            background-color: #f9f9f9;
            color: #333;
            line-height: 1.6;
        }
        
        /* Header & Navigation */
        header {
            background-color: #fff;
            box-shadow: 0 2px 15px rgba(0, 0, 0, 0.08);
            position: fixed;
            width: 100%;
            top: 0;
            z-index: 1000;
        }
        
        .container {
            width: 90%;
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 15px;
        }
        
        .logo-nav {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px 0;
        }
        
        .logo {
            font-size: 24px;
            font-weight: 700;
            color: #2c3e50;
            text-decoration: none;
        }
        
        .logo span {
            color: #e74c3c;
        }
        
        nav ul {
            display: flex;
            list-style: none;
        }
        
        nav ul li {
            margin-left: 30px;
        }
        
        nav ul li a {
            text-decoration: none;
            color: #555;
            font-weight: 600;
            font-size: 16px;
            transition: color 0.3s;
        }
        
        nav ul li a:hover {
            color: #e74c3c;
        }
        
        .mobile-menu-btn {
            display: none;
            background: none;
            border: none;
            font-size: 24px;
            color: #2c3e50;
            cursor: pointer;
        }
        
        /* Hero Slider Section */
        .hero-slider {
            height: 100vh;
            position: relative;
            margin-top: 80px;
            overflow: hidden;
        }
        
        .hero-slide {
            height: 100vh;
            position: relative;
            background-size: cover;
            background-position: center;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        
        /* Slide 1 */
        .slide-1 {
            background: linear-gradient(rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0.4)), 
                        url('https://images.unsplash.com/photo-1511285560929-80b456fea0bc?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80') center/cover;
        }
        
        /* Slide 2 */
        .slide-2 {
            background: linear-gradient(rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0.4)), 
                        url('https://images.unsplash.com/photo-1519741497674-611481863552?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80') center/cover;
        }
        
        /* Slide 3 */
        .slide-3 {
            background: linear-gradient(rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0.4)), 
                        url('https://images.unsplash.com/photo-1544005313-94ddf0286df2?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2068&q=80') center/cover;
        }
        
        /* Slide 4 */
        /* .slide-4 {
            background: linear-gradient(rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0.4)), 
                        url('https://images.unsplash.com/photo-1511988617509-a57c8a288659?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2071&q=80') center/cover;
        } */
        
        /* Slide 5 */
        /* .slide-5 {
            background: linear-gradient(rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0.4)), 
                        url('https://images.unsplash.com/photo-1465495976277-4387d4b0e4a6?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80') center/cover;
        } */
        
        .hero-content {
            text-align: center;
            max-width: 900px;
            padding: 0 20px;
            z-index: 2;
            position: relative;
        }
        
        .hero-title {
            font-size: 3.8rem;
            margin-bottom: 20px;
            color: white;
            text-shadow: 2px 2px 8px rgba(0, 0, 0, 0.5);
            opacity: 0;
            transform: translateY(30px);
            animation: fadeInUp 1s forwards 0.5s;
        }
        
        .hero-subtitle {
            font-size: 1.3rem;
            margin-bottom: 35px;
            color: rgba(255, 255, 255, 0.9);
            opacity: 0;
            transform: translateY(30px);
            animation: fadeInUp 1s forwards 0.7s;
            max-width: 700px;
            margin-left: auto;
            margin-right: auto;
        }
        
        @keyframes fadeInUp {
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        
        .btn {
            display: inline-block;
            background-color: #e74c3c;
            color: white;
            padding: 16px 38px;
            border-radius: 50px;
            text-decoration: none;
            font-weight: 600;
            font-size: 18px;
            transition: all 0.3s ease;
            border: none;
            cursor: pointer;
            opacity: 0;
            transform: translateY(30px);
            animation: fadeInUp 1s forwards 0.9s;
            box-shadow: 0 5px 20px rgba(231, 76, 60, 0.4);
        }
        
        .btn:hover {
            background-color: #c0392b;
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(231, 76, 60, 0.6);
        }
        
        /* Slider Navigation Dots */
        .slick-dots {
            bottom: 40px;
        }
        
        .slick-dots li button:before {
            font-size: 12px;
            color: rgba(255, 255, 255, 0.7);
            opacity: 0.7;
        }
        
        .slick-dots li.slick-active button:before {
            color: #e74c3c;
            opacity: 1;
        }
        
        /* Slider Arrows */
        .hero-slider .slick-prev,
        .hero-slider .slick-next {
            width: 60px;
            height: 60px;
            background-color: rgba(0, 0, 0, 0.3);
            border-radius: 50%;
            z-index: 10;
            transition: all 0.3s ease;
        }
        
        .hero-slider .slick-prev:hover,
        .hero-slider .slick-next:hover {
            background-color: rgba(231, 76, 60, 0.8);
        }
        
        .hero-slider .slick-prev {
            left: 30px;
        }
        
        .hero-slider .slick-next {
            right: 30px;
        }
        
        .hero-slider .slick-prev:before,
        .hero-slider .slick-next:before {
            font-family: 'Font Awesome 5 Free';
            font-weight: 900;
            font-size: 24px;
            color: white;
            opacity: 0.9;
        }
        
        .hero-slider .slick-prev:before {
            content: '\f053';
        }
        
        .hero-slider .slick-next:before {
            content: '\f054';
        }
        
        /* Slide Counter */
        .slide-counter {
            position: absolute;
            bottom: 40px;
            right: 40px;
            color: white;
            font-size: 14px;
            background-color: rgba(0, 0, 0, 0.4);
            padding: 8px 15px;
            border-radius: 20px;
            z-index: 10;
            font-weight: 500;
        }
        
        /* Sections */
        section {
            padding: 80px 0;
        }
        
        .section-title {
            text-align: center;
            margin-bottom: 50px;
        }
        
        .section-title h2 {
            font-size: 2.5rem;
            color: #2c3e50;
            margin-bottom: 15px;
            position: relative;
            display: inline-block;
        }   
        .section-title h2::after {
            content: '';
            position: absolute;
            width: 70px;
            height: 4px;
            background-color: #e74c3c;
            bottom: -10px;
            left: 50%;
            transform: translateX(-50%);
        }
        
        /* About Section */
        .about-content {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 40px;
        }
        
        .about-text {
            flex: 1;
            min-width: 300px;
        }
        
        .about-text h3 {
            font-size: 1.8rem;
            margin-bottom: 20px;
            color: #2c3e50;
        }
        
        .about-text p {
            font-size: 1.1rem;
            color: #555;
            margin-bottom: 20px;
        }
        
        .stats {
            display: flex;
            gap: 30px;
            margin-top: 30px;
        }
        
        .stat-item {
            text-align: center;
        }
        
        .stat-number {
            font-size: 2.5rem;
            font-weight: 700;
            color: #e74c3c;
            display: block;
        }
        
        .stat-text {
            font-size: 1rem;
            color: #777;
        }
        
        .about-image {
            flex: 1;
            min-width: 300px;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 15px 30px rgba(0, 0, 0, 0.1);
        }
        
        .about-image img {
            width: 100%;
            height: auto;
            display: block;
        }
        
        /* Featured Work Slider */
        .featured-slider-section {
            background-color: #f5f5f5;
            padding: 100px 0;
        }
        
        .slider-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
        }
        
        .featured-slider {
            position: relative;
            margin: 0 auto;
        }
        
        .slider-item {
            position: relative;
            height: 500px;
            border-radius: 15px;
            overflow: hidden;
            margin: 0 10px;
        }
        
        .slider-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease;
        }
        
        .slider-item:hover .slider-img {
            transform: scale(1.05);
        }
        
        .slider-overlay {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            background: linear-gradient(to top, rgba(0,0,0,0.8), transparent);
            color: white;
            padding: 40px 30px 30px;
            transform: translateY(20px);
            opacity: 0;
            transition: all 0.5s ease;
        }
        
        .slider-item:hover .slider-overlay {
            transform: translateY(0);
            opacity: 1;
        }
        
        .slider-category {
            background-color: #e74c3c;
            color: white;
            padding: 8px 20px;
            border-radius: 50px;
            font-size: 0.9rem;
            font-weight: 600;
            display: inline-block;
            margin-bottom: 15px;
        }
        
        .slider-title {
            font-size: 1.8rem;
            font-weight: 700;
            margin-bottom: 10px;
        }
        
        .slider-description {
            font-size: 1rem;
            opacity: 0.9;
        }
        
        /* Slider Navigation */
        .slick-prev, .slick-next {
            width: 50px;
            height: 50px;
            background-color: rgba(231, 76, 60, 0.9);
            border-radius: 50%;
            z-index: 10;
            transition: all 0.3s ease;
        }
        
        .slick-prev:hover, .slick-next:hover {
            background-color: #c0392b;
        }
        
        .slick-prev {
            left: -60px;
        }
        
        .slick-next {
            right: -60px;
        }
        
        .slick-prev:before, .slick-next:before {
            font-family: 'Font Awesome 5 Free';
            font-weight: 900;
            font-size: 20px;
            color: white;
        }
        
        .slick-prev:before {
            content: '\f053';
        }
        
        .slick-next:before {
            content: '\f054';
        }
        
        /* Portfolio Section */
        .categories {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 15px;
            margin-bottom: 40px;
        }
        
        .category-btn {
            background-color: #f1f1f1;
            border: none;
            padding: 10px 25px;
            border-radius: 50px;
            font-weight: 600;
            color: #555;
            cursor: pointer;
            transition: all 0.3s ease;
        }
        
        .category-btn.active, .category-btn:hover {
            background-color: #e74c3c;
            color: white;
        }
        
        .portfolio-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 25px;
        }
        
        .portfolio-item {
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.08);
            transition: transform 0.3s ease;
            position: relative;
        }
        
        .portfolio-item:hover {
            transform: translateY(-10px);
        }
        
        .portfolio-item img {
            width: 100%;
            height: 250px;
            object-fit: cover;
            display: block;
        }
        
        .portfolio-category {
            position: absolute;
            top: 15px;
            right: 15px;
            background-color: rgba(231, 76, 60, 0.9);
            color: white;
            padding: 5px 15px;
            border-radius: 50px;
            font-size: 0.8rem;
            font-weight: 600;
        }
        
        /* Footer */
        footer {
            background-color: #2c3e50;
            color: #ecf0f1;
            padding: 60px 0 30px;
        }
        
        .footer-content {
            display: flex;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 40px;
            margin-bottom: 40px;
        }
        
        .footer-logo {
            flex: 1;
            min-width: 250px;
        }
        
        .footer-logo h3 {
            font-size: 28px;
            margin-bottom: 15px;
        }
        
        .footer-logo span {
            color: #e74c3c;
        }
        
        .footer-contact {
            flex: 1;
            min-width: 250px;
        }
        
        .footer-contact h4 {
            font-size: 1.3rem;
            margin-bottom: 20px;
            color: #ecf0f1;
        }
        
        .contact-info {
            display: flex;
            flex-direction: column;
            gap: 15px;
        }
        
        .contact-item {
            display: flex;
            align-items: center;
            gap: 15px;
        }
        
        .contact-icon {
            background-color: #e74c3c;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        
        .social-links {
            display: flex;
            gap: 15px;
            margin-top: 20px;
        }
        
        .social-link {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 40px;
            height: 40px;
            background-color: #34495e;
            border-radius: 50%;
            color: white;
            text-decoration: none;
            transition: background-color 0.3s;
        }
        
        .social-link:hover {
            background-color: #e74c3c;
        }
        
        .copyright {
            text-align: center;
            padding-top: 30px;
            border-top: 1px solid #34495e;
            color: #bdc3c7;
            font-size: 0.9rem;
        }
        
        /* Responsive Design */
        @media (max-width: 1200px) {
            .slick-prev {
                left: -20px;
            }
            
            .slick-next {
                right: -20px;
            }
        }
        
        @media (max-width: 992px) {
            .hero-title {
                font-size: 3rem;
            }
            
            .portfolio-grid {
                grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            }
            
            .slider-item {
                height: 400px;
            }
            
            .hero-slider .slick-prev,
            .hero-slider .slick-next {
                width: 50px;
                height: 50px;
            }
            
            .hero-slider .slick-prev {
                left: 15px;
            }
            
            .hero-slider .slick-next {
                right: 15px;
            }
            
            .slide-counter {
                bottom: 30px;
                right: 30px;
            }
        }
        
        @media (max-width: 768px) {
            .mobile-menu-btn {
                display: block;
            }
            
            nav ul {
                position: fixed;
                top: 80px;
                left: -100%;
                width: 100%;
                background-color: white;
                flex-direction: column;
                align-items: center;
                padding: 20px 0;
                box-shadow: 0 10px 15px rgba(0, 0, 0, 0.1);
                transition: left 0.3s ease;
            }
            
            nav ul.show {
                left: 0;
            }
            
            nav ul li {
                margin: 15px 0;
            }
            
            .hero-title {
                font-size: 2.5rem;
            }
            
            .hero-subtitle {
                font-size: 1.1rem;
            }
            
            .section-title h2 {
                font-size: 2rem;
            }
            
            .slick-prev, .slick-next {
                width: 40px;
                height: 40px;
            }
            
            .slick-prev:before, .slick-next:before {
                font-size: 16px;
            }
            
            .slider-item {
                height: 350px;
            }
            
            .hero-slider .slick-prev,
            .hero-slider .slick-next {
                display: none !important;
            }
            
            .slide-counter {
                bottom: 20px;
                right: 20px;
                font-size: 12px;
                padding: 6px 12px;
            }
        }
        
        @media (max-width: 576px) {
            .hero-slider {
                height: 90vh;
            }
            
            .hero-slide {
                height: 90vh;
            }
            
            .hero-title {
                font-size: 2.2rem;
            }
            
            .hero-subtitle {
                font-size: 1rem;
            }
            
            .btn {
                padding: 14px 30px;
                font-size: 16px;
            }
            
            section {
                padding: 60px 0;
            }
            
            .stats {
                flex-direction: column;
                gap: 20px;
            }  
                     
            .slider-item {
                height: 300px;
            }          
            .testimonial-item {
                padding: 25px;
            }           
            .slick-prev {
                left: 10px;
            }          
            .slick-next {
                right: 10px;
            }
        }
    </style>
</head>
<body>
    <!-- Header & Navigation -->
    <header>
        <div class="container">
            <div class="logo-nav">
                <a href="#" class="logo">Photo<span>Graphy</span></a>
                <button class="mobile-menu-btn" id="mobileMenuBtn">
                    <i class="fas fa-bars"></i>
                </button>
                <nav>
                    <ul id="navMenu">
                        <li><a href="/">Home</a></li>
                        <li><a href="/portfolio">Portfolio</a></li>
                        <li><a href="/service">Services</a></li>
                        <li><a href="packages">Packages</a></li>
                        <li><a href="/about">About</a></li>
                        <li><a href="/contact">Contact</a></li>
                    </ul>
                </nav>
            </div>
        </div>
    </header>

    <!-- Hero Slider Section -->
    <section class="hero-slider" id="home">
        <!-- Slide 1 -->
        <div class="hero-slide slide-1">
            <div class="hero-content">
                <h1 class="hero-title">Capturing Moments That Last Forever</h1>
                <p class="hero-subtitle">Professional wedding & portrait photographer with 5+ years experience creating timeless memories you'll cherish for a lifetime.</p>
                <!-- <a href="#contact" class="btn">Book Now</a> -->
            </div>
        </div>    
        <!-- Slide 2 -->
        <div class="hero-slide slide-2">
            <div class="hero-content">
                <h1 class="hero-title">Wedding Photography Excellence</h1>
                <p class="hero-subtitle">Capturing the magic of your special day with artistic vision and attention to every precious detail.</p>
                <!-- <a href="#portfolio" class="btn">View Portfolio</a> -->
            </div>
        </div>
        
        <!-- Slide 3 -->
        <div class="hero-slide slide-3">
            <div class="hero-content">
                <h1 class="hero-title">Portrait Perfection</h1>
                <p class="hero-subtitle">Creating stunning portraits that reveal personality and tell your unique story through timeless imagery.</p>
                <!-- <a href="#contact" class="btn">Schedule a Session</a> -->
            </div>
        </div>
    </section>

    <!-- About Section -->
    <section id="about">
        <div class="container">
            <div class="section-title">
                <h2>About Me</h2>
            </div>
            <div class="about-content">
                <div class="about-text">
                    <h3>Professional Photographer with Passion for Storytelling</h3>
                    <p>With over 5 years of professional photography experience, I specialize in capturing authentic moments that tell your unique story. My approach combines technical expertise with a keen eye for emotion and detail.</p>
                    <p>I believe every photograph should be a work of art that evokes feeling and preserves memories for generations to come. Whether it's your wedding day, a family portrait, or a special event, I'm dedicated to creating images you'll treasure forever.</p>
                    
                    <div class="stats">
                        <div class="stat-item">
                            <span class="stat-number">5+</span>
                            <span class="stat-text">Years Experience</span>
                        </div>
                        <div class="stat-item">
                            <span class="stat-number">200+</span>
                            <span class="stat-text">Happy Clients</span>
                        </div>
                        <div class="stat-item">
                            <span class="stat-number">5000+</span>
                            <span class="stat-text">Photos Delivered</span>
                        </div>
                    </div>
                </div>
                <div class="about-image">
                    <img src="https://images.unsplash.com/photo-1554048612-b6a482bc67e5?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80" alt="Photographer at work">
                </div>
            </div>
        </div>
    </section>

    <!-- Portfolio Section -->
    <section id="portfolio">
        <div class="container">
            <div class="section-title">
                <h2>Portfolio Gallery</h2>
            </div>
            
            <div class="categories">
                <button class="category-btn active" data-filter="all">All</button>
                <button class="category-btn" data-filter="wedding">Wedding</button>
                <button class="category-btn" data-filter="pre-wedding">Pre-wedding</button>
                <button class="category-btn" data-filter="portrait">Portrait</button>
                <button class="category-btn" data-filter="events">Events</button>
                <button class="category-btn" data-filter="nature">Nature</button>
            </div>
            
            <div class="portfolio-grid">
                <!-- Wedding Images -->
